# Application
NODE_ENV=development
NEST_PORT=3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_service

# JWT — must be identical in ivcf-back and tecnoaging-back
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Swagger (optional)
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Auth Service

# Password recovery
PASSWORD_RECOVERY_TOKEN_EXPIRY_HOURS=24
FRONTEND_BASE_URL=http://localhost:3000
